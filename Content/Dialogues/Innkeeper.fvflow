{
  "$schema": "../.schemas/flow.schema.json",
  "nodes": [
    {
      "$type": "start",
      "id": "start",
      "x": 0,
      "y": 0
    },
    {
      "$type": "line",
      "speaker": "",
      "text": {
        "key": "Dialogue.Innkeeper.Greet",
        "text": "Evening, fox. Mind the floor, it\u0027s just been waxed.",
        "note": "The innkeeper\u0027s greeting when the fox walks up to talk."
      },
      "mood": "",
      "duration": 0,
      "skippable": true,
      "waitForInput": false,
      "id": "greet",
      "x": 220,
      "y": 0
    },
    {
      "$type": "choice",
      "options": [
        {
          "text": {
            "key": "Dialogue.Innkeeper.Choice.Ask",
            "text": "Anything I can do for you?",
            "note": "A dialogue choice: the fox offers help."
          },
          "conditions": {
            "mode": "All",
            "conditions": [
              {
                "$type": "questState",
                "quest": "Quest.Cellar",
                "state": "NotStarted",
                "invert": false
              }
            ],
            "failurePresentation": "Hidden",
            "failureReason": {
              "key": "",
              "text": "",
              "note": ""
            }
          },
          "onChosen": {
            "effects": [
              {
                "$type": "setQuestState",
                "quest": "Quest.Cellar",
                "state": "Active"
              }
            ]
          }
        },
        {
          "text": {
            "key": "Dialogue.Innkeeper.Choice.Found",
            "text": "I found your cellar key.",
            "note": "A dialogue choice, shown once the key is found: the fox returns it."
          },
          "conditions": {
            "mode": "All",
            "conditions": [
              {
                "$type": "questState",
                "quest": "Quest.Cellar",
                "state": "Active",
                "invert": false
              },
              {
                "$type": "hasItem",
                "item": "Items/CellarKey.fvdata",
                "quantity": 1,
                "subject": "Instigator",
                "invert": false
              }
            ],
            "failurePresentation": "Hidden",
            "failureReason": {
              "key": "",
              "text": "",
              "note": ""
            }
          },
          "onChosen": {
            "effects": []
          }
        },
        {
          "text": {
            "key": "Dialogue.Innkeeper.Choice.Cellar",
            "text": "What\u0027s down in the cellar?",
            "note": "A dialogue choice: the fox asks about the cellar."
          },
          "conditions": {
            "mode": "All",
            "conditions": [
              {
                "$type": "knows",
                "knowledge": "Knowledge.Topic.Cellar",
                "invert": true
              }
            ],
            "failurePresentation": "Hidden",
            "failureReason": {
              "key": "",
              "text": "",
              "note": ""
            }
          },
          "onChosen": {
            "effects": [
              {
                "$type": "learn",
                "knowledge": "Knowledge.Topic.Cellar"
              }
            ]
          }
        }
      ],
      "id": "ask",
      "x": 440,
      "y": 0
    },
    {
      "$type": "line",
      "speaker": "",
      "text": {
        "key": "Dialogue.Innkeeper.Job",
        "text": "I\u0027ve lost the cellar key somewhere in this room. Find it and the wine\u0027s on me.",
        "note": "The innkeeper explains that the cellar key is lost somewhere in the room."
      },
      "mood": "",
      "duration": 0,
      "skippable": true,
      "waitForInput": false,
      "id": "job",
      "x": 700,
      "y": -120
    },
    {
      "$type": "completeObjective",
      "objective": "Quest.Cellar.ReturnedKey",
      "id": "returned",
      "x": 700,
      "y": 0
    },
    {
      "$type": "line",
      "speaker": "",
      "text": {
        "key": "Dialogue.Innkeeper.Thanks",
        "text": "Keep it. Go on, open the cellar yourself.",
        "note": "The innkeeper\u0027s reply when the fox has found the key; the innkeeper lets the fox keep it."
      },
      "mood": "",
      "duration": 0,
      "skippable": true,
      "waitForInput": false,
      "id": "thanks",
      "x": 920.8745,
      "y": 0
    },
    {
      "$type": "line",
      "speaker": "",
      "text": {
        "key": "Dialogue.Innkeeper.Lore",
        "text": "Wine, mostly. And whatever the last owner left behind.",
        "note": "The innkeeper\u0027s answer about what is in the cellar."
      },
      "mood": "",
      "duration": 0,
      "skippable": true,
      "waitForInput": false,
      "id": "lore",
      "x": 448.2649,
      "y": 182.89438
    },
    {
      "$type": "finish",
      "id": "end",
      "x": 1140,
      "y": 0
    }
  ],
