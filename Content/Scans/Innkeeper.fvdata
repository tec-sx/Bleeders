    { "label": { "key": "Scan.Innkeeper.Apron.Label", "text": "Apron", "note": "The heading of one thing the scan of the innkeeper tells." }, "text": { "key": "Scan.Innkeeper.Apron", "text": "Wine stains, old and new.", "note": "What the scan of the innkeeper tells under Apron." } },
    { "label": { "key": "Scan.Innkeeper.Keys.Label", "text": "Keys", "note": "The heading of one thing the scan of the innkeeper tells." }, "text": { "key": "Scan.Innkeeper.Keys", "text": "A ring of keys on the belt, one hook empty.", "note": "What the scan of the innkeeper tells under Keys." },
