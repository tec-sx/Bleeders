{
  "$schema": "../.schemas/data.schema.json",
  "type": "item",
  "id": "Item.Ale",
  "display": { "name": { "key": "Item.Ale.Name", "text": "Mug of ale", "note": "The name of the item Ale." }, "shortDescription": { "key": "Item.Ale.Short", "text": "Dark, sweet and strong.", "note": "The short description of the item Ale." } },
  "category": "Item.Drink",
  "weight": 0.5,
  "fragments": [
    { "$type": "usable", "effects": { "effects": [
      { "$type": "modifyAttribute", "attribute": "Attribute.Physical.Intoxication", "delta": 30 },
      { "$type": "applyModifier", "modifier": "Modifiers/Drunk.fvdata" } ] } }
  ]
}
