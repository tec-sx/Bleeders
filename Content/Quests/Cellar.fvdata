{
  "$schema": "../.schemas/data.schema.json",
  "type": "quest",
  "id": "Quest.Cellar",
  "display": { "name": { "key": "Quest.Cellar.Name", "text": "The cellar key", "note": "The name of the quest Cellar." }, "shortDescription": { "key": "Quest.Cellar.Short", "text": "The innkeeper lost the key to the cellar.", "note": "The short description of the quest Cellar." } },
  "flow": "Quests/Cellar.fvflow",
  "objectives": [
    {
      "fact": "Quest.Cellar.FoundKey",
      "description": { "key": "Quest.Cellar.FindKey", "text": "Find the cellar key", "note": "A quest objective in the tracker: the key is somewhere in the inn." },
      "completeWhen": { "conditions": [ { "$type": "hasItem", "item": "Items/CellarKey.fvdata" } ] }
    },
    {
      "fact": "Quest.Cellar.ReturnedKey",
      "description": { "key": "Quest.Cellar.TellInnkeeper", "text": "Tell the innkeeper", "note": "A quest objective in the tracker, once the key is found: the innkeeper is told." },
      "visibleWhen": { "conditions": [ { "$type": "fact", "fact": "Quest.Cellar.FoundKey" } ] }
    }
  ],
  "onCompleted": { "effects": [ { "$type": "giveMoney", "amount": 5 } ] }
}
